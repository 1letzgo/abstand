<?xml version="1.0" encoding="utf-8"?>
<!-- iOS: NSAllowsLocalNetworking. Android kennt keine LAN-Ausnahme, daher Klartext erlaubt;
     selbstsignierte Zertifikate akzeptiert nur Net.kt (LocalHosts) für LAN-Hosts. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
