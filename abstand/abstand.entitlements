<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay-Audio: von Apple für dieses Team freigegeben (https://developer.apple.com/contact/carplay/).
	     Ohne die Freigabe scheitert bereits die Signierung — der Schlüssel darf also nicht
	     spekulativ gesetzt werden. Die zugehörige Scene steht in Config/Info.plist
	     (CPTemplateApplicationSceneSessionRoleApplication → CarPlaySceneDelegate). -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
